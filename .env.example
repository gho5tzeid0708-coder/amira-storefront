# Public (safe for browser) — from Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER expose to the browser. Used only in app/admin/* server code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Simple password gate for /admin (swap for Supabase Auth later if you want per-staff logins)
ADMIN_PASSWORD=change-me
